DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@<db_host>:3306/mahesh_meds
API_PORT=8000
DEBUG=false
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ORIGINS=https://your-frontend-domain.example
# Hours an approved request keeps its reserved stock before it expires (default 72).
PICKUP_WINDOW_HOURS=72
# Aadhaar card photos: the private Cloud Storage bucket they are kept in (production). Without it, photos are
# refused. For development, leave it empty and name a local folder instead, e.g. AADHAR_PHOTO_DIR=.local-photos
AADHAR_PHOTO_BUCKET=
# Days after a request is finished (rejected, returned, expired) before its Aadhaar photos are deleted.
# Empty keeps them. The Aadhaar numbers are always kept.
AADHAR_PHOTO_RETENTION_DAYS=
# JWT_SECRET must be at least 32 characters. Generate one with:
# python -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=

# Local development overrides:
# DEBUG=true
# COOKIE_SECURE=false
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Phone on same Wi-Fi (frontend Vite proxy — recommended):
#   DEBUG=true  → CORS allows http://192.168.x.x:8080 automatically
#   uvicorn app.main:app --reload --host 127.0.0.1 --port 8000
#   Frontend: npm run dev → npm run lan:url → open that URL on the phone
#
# Phone calling API directly (no proxy):
#   uvicorn app.main:app --reload --host 0.0.0.0 --port 8000
#   CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://192.168.29.43:8080

# SMS service
SMS_ENABLED=true
SMS_PEID=
SMS_API_KEY=replace-with-provider-api-key
SMS_USERNAME=replace-with-provider-username
SMS_SENDER=MHSFND
SMS_BASE_URL=http://www.bulksmsapps.com/api/apismsv2.aspx
SMS_TIMEOUT_SECONDS=10
# The SMS templates registered in October 2026 (app/notifications.py). false = everything on the earlier templates.
SMS_NEW_TEMPLATES=true
# The approval SMS naming the pickup center's manager and number; off until DLT confirms a phone number may sit
# in an alphanumeric variable.
SMS_APPROVED_WITH_CONTACT=false
# Site address used for links in SMS.
PUBLIC_SITE_URL=https://maheshfoundation-medical.com

# Enable live sending only after PEID is confirmed and DLT template IDs
# are populated in the sms_templates table.
