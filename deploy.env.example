# Copy to deploy.env (never commit it) before running deploy_gcp.sh on a fresh server.
# Only used when the API's .env does not exist yet; an existing .env is kept as it is.

# BulkSMS / DLT credentials. Leave empty to install with SMS disabled.
SMS_API_KEY=
SMS_USERNAME=
SMS_PEID=

# First master admin (logs in with this mobile number + OTP). Optional.
BOOTSTRAP_ADMIN_MOBILE=
BOOTSTRAP_ADMIN_NAME=
